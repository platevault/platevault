{
  "name": "@platevault/desktop-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "pnpm i18n:compile && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "typecheck": "pnpm i18n:compile && tsc -p tsconfig.json --noEmit --incremental false && tsc -p tsconfig.node.json --noEmit",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy custom-preferences baseLocale --emit-ts-declarations",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev --host 127.0.0.1 --port 6180 --exact-port --no-open",
    "themes:check": "node scripts/themes.mjs --check",
    "build-storybook": "pnpm i18n:compile && storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@inlang/paraglide-js": "^2.22.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2.12.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "shadcn": "^4.22.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.5"
  }
}
