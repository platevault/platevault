{
  "name": "@platevault/desktop-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "pnpm i18n:compile && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "typecheck": "pnpm i18n:compile && tsc -p tsconfig.json --noEmit --incremental false && tsc -p tsconfig.node.json --noEmit",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy custom-preferences baseLocale --emit-ts-declarations",
    "lint": "pnpm lint:eslint && pnpm lint:i18n && pnpm check-catalogue",
    "lint:eslint": "eslint --max-warnings 0 src/",
    "lint:i18n": "node scripts/check-i18n-catalog.mjs && node scripts/check-i18n-locale-drift.mjs && node scripts/check-copy.mjs && node scripts/check-eslint-directives.mjs",
    "check-catalogue": "node scripts/check-catalogue.mjs",
    "census": "node scripts/census.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lint-rules": "node --test eslint-rules/tests/*.test.mjs scripts/*.test.mjs",
    "storybook": "storybook dev --host 127.0.0.1 --port 6180 --exact-port --no-open",
    "themes": "node scripts/themes.mjs",
    "themes:check": "node scripts/themes.mjs --check",
    "build-storybook": "pnpm i18n:compile && storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@inlang/paraglide-js": "^2.22.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "^1.170.41",
    "@tauri-apps/api": "^2.12.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "4.12.1",
    "eslint": "^10.7.0",
    "jsdom": "^30.1.2",
    "shadcn": "^4.21.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
