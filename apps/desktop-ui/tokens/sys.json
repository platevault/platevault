{
  "$description": "PlateVault system tokens (DTCG Format 2025.10). scripts/themes.mjs generates src/themes.css from this file and comp.json; colour roles per theme come from the palettes in that script. A token's CSS name is its path without the tier, joined with '-' ($root dropped).",
  "sys": {
    "font": {
      "$type": "fontFamily",
      "sans": {
        "$description": "The platform UI face: SF Pro on macOS, Segoe UI on Windows.",
        "$value": ["-apple-system", "BlinkMacSystemFont", "SF Pro Text", "Segoe UI", "system-ui", "Helvetica Neue", "sans-serif"]
      },
      "mono": {
        "$value": ["ui-monospace", "SF Mono", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
      }
    },
    "text": {
      "$type": "dimension",
      "$description": "Desktop type scale (ratio ~1.15): 11 caption, 13 body, 15 title, 17 window title. Each size carries its line height.",
      "xs": {
        "$root": { "$value": { "value": 0.6875, "unit": "rem" } },
        "line-height": { "$value": { "value": 1, "unit": "rem" } }
      },
      "sm": {
        "$root": { "$value": { "value": 0.8125, "unit": "rem" } },
        "line-height": { "$value": { "value": 1.125, "unit": "rem" } }
      },
      "base": {
        "$root": { "$value": { "value": 0.875, "unit": "rem" } },
        "line-height": { "$value": { "value": 1.25, "unit": "rem" } }
      },
      "lg": {
        "$root": { "$value": { "value": 0.9375, "unit": "rem" } },
        "line-height": { "$value": { "value": 1.375, "unit": "rem" } }
      },
      "xl": {
        "$root": { "$value": { "value": 1.0625, "unit": "rem" } },
        "line-height": { "$value": { "value": 1.5, "unit": "rem" } }
      },
      "2xl": {
        "$root": { "$value": { "value": 1.375, "unit": "rem" } },
        "line-height": { "$value": { "value": 1.75, "unit": "rem" } }
      }
    },
    "spacing": {
      "$type": "dimension",
      "$description": "One spacing step: gap-2, p-4 and the like are multiples of it.",
      "$value": { "value": 0.25, "unit": "rem" }
    },
    "radius": {
      "$type": "dimension",
      "$root": {
        "$description": "Controls 5 px, popovers 8 px; panes and lists are square.",
        "$value": { "value": 0.3125, "unit": "rem" }
      },
      "sm": { "$value": { "value": 0.1875, "unit": "rem" }, "$extensions": { "app.platevault.calc": "{sys.radius.$root} * 0.6" } },
      "md": { "$value": { "value": 0.25, "unit": "rem" }, "$extensions": { "app.platevault.calc": "{sys.radius.$root} * 0.8" } },
      "lg": { "$value": "{sys.radius.$root}" },
      "xl": { "$value": { "value": 0.4375, "unit": "rem" }, "$extensions": { "app.platevault.calc": "{sys.radius.$root} * 1.4" } },
      "2xl": { "$value": { "value": 0.5625, "unit": "rem" }, "$extensions": { "app.platevault.calc": "{sys.radius.$root} * 1.8" } }
    },
    "control-h": {
      "$type": "dimension",
      "sm": { "$description": "Small controls, menu items and in-row controls.", "$value": { "value": 1.5, "unit": "rem" } },
      "md": { "$description": "Inputs and selects.", "$value": { "value": 1.75, "unit": "rem" } }
    },
    "row-h": {
      "$type": "dimension",
      "$description": "Table and list row height. Rows never drop below the 24 px target minimum (WCAG 2.5.8).",
      "$value": { "value": 1.625, "unit": "rem" }
    },
    "row-py": {
      "$type": "dimension",
      "$description": "Row cell padding: whatever the row height leaves around an in-row control and the row's 1 px bottom border, so single-line rows are exactly the row height.",
      "$value": { "value": 0.03125, "unit": "rem" },
      "$extensions": { "app.platevault.calc": "({sys.row-h} - {sys.control-h.sm} - 0.0625) / 2" }
    },
    "elevation": {
      "$type": "shadow",
      "0": {
        "$description": "Flat: panes, tables and group boxes.",
        "$value": { "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
      },
      "1": {
        "$description": "Raised: outline push buttons.",
        "$value": { "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.06 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 1, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
      },
      "2": {
        "$description": "Floating: menus, popovers, selects and comboboxes.",
        "$value": [
          { "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.35 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0.5, "unit": "px" } },
          { "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.45 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 10, "unit": "px" }, "blur": { "value": 28, "unit": "px" }, "spread": { "value": -6, "unit": "px" } }
        ]
      },
      "3": {
        "$description": "Modal: dialogs and alert dialogs.",
        "$value": [
          { "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.4 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0.5, "unit": "px" } },
          { "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.55 }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 24, "unit": "px" }, "blur": { "value": 60, "unit": "px" }, "spread": { "value": -12, "unit": "px" } }
        ]
      }
    },
    "scrim": {
      "$type": "color",
      "$description": "The dim behind a modal dialog or sheet.",
      "$value": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.28 }
    },
    "z": {
      "$type": "number",
      "page": { "$description": "Page content.", "$value": 0 },
      "pinned": { "$description": "Pinned table columns over the scrolled cells.", "$value": 1 },
      "sticky": { "$description": "Sticky table and pane headers.", "$value": 10 },
      "shell": { "$description": "Shell chrome: toolbar, sidebar, status bar.", "$value": 20 },
      "flyout": { "$description": "Flyouts inside the shell.", "$value": 30 },
      "overlay": { "$description": "Portalled layers: dialogs, sheets, menus, popovers, tooltips, toasts.", "$value": 50 }
    }
  }
}
