{
  "name": "@platevault/prototype",
  "private": true,
  "version": "0.0.0",
  "description": "PlateVault UI prototype backed by an in-browser fixture store. Not the production frontend.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "pnpm i18n:compile && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "typecheck": "pnpm i18n:compile && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy custom-preferences baseLocale --emit-ts-declarations",
    "lint": "pnpm lint:baseline && pnpm lint:i18n",
    "lint:baseline": "node scripts/check-eslint-baseline.mjs",
    "lint:eslint": "eslint src/",
    "lint:i18n": "node scripts/check-i18n-catalog.mjs && node scripts/check-i18n-locale-drift.mjs",
    "themes": "node scripts/themes.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@inlang/paraglide-js": "^2.22.0",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.7.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6"
  }
}
